{
  "name": "@video-ultra/ai",
  "version": "0.0.0",
  "description": "Optional on-device AI for video-ultra: background removal in a worker, nothing uploaded.",
  "license": "MIT",
  "author": "Ultranmus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ultranmus/video-ultra.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/Ultranmus/video-ultra/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "video-editor",
    "background-removal",
    "segmentation",
    "on-device",
    "onnx"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@video-ultra/core": "workspace:^"
  },
  "dependencies": {
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0"
  },
  "devDependencies": {
    "@video-ultra/core": "workspace:^",
    "@webgpu/types": "^0.1.74",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
