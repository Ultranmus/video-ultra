{
  "name": "video-ultra-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "playground": "turbo run build --filter=@video-ultra/react && pnpm --filter playground dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "e2e": "turbo run e2e",
    "media": "node scripts/test-media.ts",
    "verify": "pnpm shaders --check && pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test",
    "shaders": "node scripts/shaders.ts",
    "docs:api": "typedoc"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "emojibase-data": "18.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "turbo": "^2.11.9",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
